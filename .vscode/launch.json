{
  "liveServer.settings.donotVerifyTags": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true,
  "editor.bracketPairColorization.enabled": true,
  "workbench.colorTheme": "Visual Studio 2017 Dark - C++",
  "editor.tabSize": 2,
  "editor.tabCompletion": "on",
  "window.confirmSaveUntitledWorkspace": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "prettier.embeddedLanguageFormatting": "auto",
  "prettier.ignorePath": ".prettierignore",
  "prettier.quoteProps": "preserve",
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,
  "editor.overtypeCursorStyle": "line",
  "editor.guides.bracketPairs": "active",
  "workbench.iconTheme": "material-icon-theme",
  "code-runner.runInTerminal": true,
  "code-runner.executorMap": {
    "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt"
  },
  "code-runner.executorMapByGlob": {
    "pom.xml": "cd $dir && mvn clean package"
  },
  "javascript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
  "typescript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
  "explorer.confirmDragAndDrop": false,
  "emmet.includeLanguages": {
    "javascript": "html",
    "vue-html": "html"
  },
  "emmet.triggerExpansionOnTab": true,
  "cmake.cmakePath": "C:/Program Files/CMake/bin/cmake.exe",
  "terminal.integrated.profiles.windows": {
    "MSYS2 MINGW64": {
      "path": "C:/msys64/ucrt64/bin",
      "args": ["--login", "-i"],
      "env": {
        "MSYSTEM": "MINGW64",
        "CHERE_INVOKING": "1"
      }
    }
  },
  "terminal.integrated.defaultProfile.windows": "MSYS2 MINGW64",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}://*.qrc": "default",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}://*.ui": "default",
    "*.qrc": "qt-core.qrcEditor"
  },
  "qt-core.qtInstallationRoot": "C:\\Qt",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4o-mini",
  "configurations": []
}
