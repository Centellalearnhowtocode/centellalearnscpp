{
    "liveServer.settings.donotVerifyTags": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true,
    "editor.bracketPairColorization.enabled": true,
    "workbench.colorTheme": "Visual Studio 2017 Dark - C++",
    "editor.tabSize": 2,
    "editor.tabCompletion": "on",
    "window.confirmSaveUntitledWorkspace": false,
    "liveServer.settings.donotShowInfoMsg": true,
    "prettier.embeddedLanguageFormatting": "auto",
    "prettier.ignorePath": ".prettierignore",
    "prettier.quoteProps": "preserve",
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 1000,
    "editor.overtypeCursorStyle": "line",
    "editor.guides.bracketPairs": "active",
    "workbench.iconTheme": "material-icon-theme",
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "cpp": "cd $dir && g++ $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt"
    },
    "code-runner.executorMapByGlob": {
        "pom.xml": "cd $dir && mvn clean package"
    },
    "javascript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
    "typescript.format.insertSpaceAfterKeywordsInControlFlowStatements": false,
    "explorer.confirmDragAndDrop": false,
    "emmet.includeLanguages": {
        "javascript": "html",
        "vue-html": "html"
    },
    "emmet.triggerExpansionOnTab": true,
    "cmake.cmakePath": "C:/Program Files/CMake/bin/cmake.exe",
    "terminal.integrated.profiles.windows": {
        "MSYS2 MINGW64": {
            "path": "C:/msys64/ucrt64/bin",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "MSYSTEM": "MINGW64",
                "CHERE_INVOKING": "1"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "MSYS2 MINGW64",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}://*.qrc": "default",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}://*.ui": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "qt-core.qtInstallationRoot": "C:\\Qt",
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4o-mini",
    "configurations": [
        {
            "name": "C/C++: gcc.exe build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc.exe build active file"
        },
        {
            "name": "C/C++: g++.exe build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build active file"
        }
    ],
    "version": "2.0.0"
}